{
    "name": "phpdocumentor/guides-llms",
    "description": "Output formats that describe a rendered manual to the tools and language models that read it, rather than to a person. Currently a \"toc\" format, writing the manual's table of contents as toc.json.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://www.phpdoc.org",
    "config": {
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "phpDocumentor\\Guides\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "phpDocumentor\\Guides\\": [
                "tests/unit/"
            ]
        }
    },
    "minimum-stability": "stable",
    "require": {
        "php": "^8.1",
        "ext-json": "*",
        "phpdocumentor/guides": "^1.0 || ^2.0",
        "psr/event-dispatcher": "^1.0",
        "symfony/dependency-injection": "^6.4 || ^7.0 || ^8.0"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.x-dev"
        }
    }
}
